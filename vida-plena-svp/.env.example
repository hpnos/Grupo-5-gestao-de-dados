# Copie para .env e troque TODOS os valores. O .env não vai para o Git.
POSTGRES_PASSWORD=troque-senha-superusuario
SVP_API_PASSWORD=troque-senha-api
SVP_ETL_PASSWORD=troque-senha-etl
SVP_BI_PASSWORD=troque-senha-bi

# segredo do JWT: no mínimo 32 caracteres aleatórios
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SVP_JWT_SECRET=troque-por-um-valor-aleatorio-longo
# chave Fernet que cifra os segredos de MFA
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SVP_CHAVE_CIFRA=troque-por-uma-chave-fernet
# chave do HMAC que pseudonimiza ids no data warehouse
SVP_ETL_CHAVE_PSEUDONIMO=troque-por-um-valor-aleatorio

# integração com o laboratório (o simulado usa os mesmos valores)
LAB_API_TOKEN=troque-token-api-laboratorio
LAB_WEBHOOK_SECRET=troque-segredo-webhook-laboratorio
